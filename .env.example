# --- Idira tenant (upstream Discovery & Context API) -------------------------
# Tenant subdomain: the API is called at https://<subdomain>.inventory.cyberark.cloud/api/graphql
IDIRA_SUBDOMAIN=acme
# Identity tenant URL: platform tokens come from <url>/oauth2/platformtoken
IDIRA_IDENTITY_URL=https://abc1234.id.cyberark.cloud
# Service user (OAuth confidential client) that is a member of the Machines Admin role
IDIRA_CLIENT_ID=svc-disco-mcp@cyberark.cloud.1234
IDIRA_CLIENT_SECRET=
# Optional full-URL overrides for tenants on other domains
# IDIRA_DISCO_GRAPHQL_URL=
# IDIRA_PLATFORM_TOKEN_URL=
# IDIRA_TIMEOUT_MS=30000

# --- This MCP server ---------------------------------------------------------
# Public HTTPS URL of the MCP endpoint, exactly as clients and the Identity Broker reach it.
# It is the OAuth resource identifier, and its path is the path the endpoint is served on.
MCP_PUBLIC_URL=https://disco-mcp.example.com/mcp
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Extra Host header values to accept (the public hostname is always accepted)
# MCP_ALLOWED_HOSTS=
# LOG_LEVEL=info

# --- OAuth 2.1 (who may call this server) ------------------------------------
# Issuer of the authorization server whose access tokens this server accepts
OAUTH_ISSUER_URL=https://login.example.com/oauth2/default
# Accepted token audience(s). Defaults to MCP_PUBLIC_URL.
# OAUTH_AUDIENCE=
# Only needed if the authorization server metadata has no jwks_uri
# OAUTH_JWKS_URI=
# Scope every request must carry, and extra scopes per kind of operation (all optional)
# OAUTH_REQUIRED_SCOPES=disco
# OAUTH_SCOPES_READ=disco:read
# OAUTH_SCOPES_WRITE=disco:write
# OAUTH_SCOPES_DELETE=disco:delete
# Local development only, loopback bind only: serve without authentication
# MCP_AUTH_DISABLED=false

# --- Behaviour ---------------------------------------------------------------
# Entities per upstream add/replace request
# DISCO_BATCH_SIZE=100
# Allow the secretValue field (raw secret values) to be sent to the inventory. Off by default.
# DISCO_ALLOW_SECRET_VALUES=false
